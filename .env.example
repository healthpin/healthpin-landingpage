# Base URL of the Health Pin backend (no trailing slash). Public: sent to the browser.
# The backend must list this site's origin in CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional map tiles. The default is OpenStreetMap's public tile server, which is
# for light traffic only (https://operations.osmfoundation.org/policies/tiles/).
# For production traffic use a tile provider you have an account with.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Your tile provider

# Optional, server-side only. Nominatim-compatible geocoder used by /api/geocode.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=HealthPinLanding/1.0 (you@healthpin.in)
